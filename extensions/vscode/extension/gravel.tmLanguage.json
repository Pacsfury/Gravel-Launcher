{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gravel",
  "scopeName": "source.grv",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.grv",
          "match": "//.*$"
        },
        {
          "name": "comment.block.grv",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.grv",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.grv",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.grv",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.grv",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.return.grv",
          "match": "\\b(return)\\b"
        },
        {
          "name": "keyword.control.conditional.grv",
          "match": "\\b(if|elseif|else|int|char|float)\\b"
        },
        {
          "name": "keyword.control.grv",
          "match": "\\b(type|__USE__|extl|impl)\\b"
        },
        {
          "name": "keyword.declaration.grv",
          "match": "\\b(fun|val|const|class|import|package: |namespace|end|while|for|repeat)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.grv",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.grv",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.grv",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.grv",
          "match": "==|!=|<=|>=|\\+|-|\\*|/|=|<|>|\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.delimiter.grv",
          "match": "[(),:;]"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.grv" }
          }
        }
      ]
    }
  }
}
