package: math

fun math.factorial(int n) int
    if n <= 1 return 1 end

    return n * math.factorial(n - 1)
end

fun math.sumative(int n) int
    if n <= 1 return 1 end

    return n + math.sumative(n - 1)
end

fun math.power(int a, int b) int
    if b == 0 return 1 end
    if b == 1 return a end

    int base = a
    int exp = b

    int res = 1
    for i in exp
        res *= base
    end
    return res
end
