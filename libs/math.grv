package: math

fun math.factorial(int n) int
    if n <= 1 return 1 end

    return n * math.factorial(n - 1)
end

fun math.sumative(int n) int
    if n <= 1 return 1 end

    return n + math.sumative(n - 1)
end

fun math.power(int a, int b) float
    if b == 0 return 1 end
    if b == 1 return a end

    float base = a
    int exp = b

    if exp < 0
        base = 1 / base
        exp = -exp
    end

    float res = 1
    for i in exp
        res *= base
    end
    return res
end
