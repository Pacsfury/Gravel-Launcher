namespace MathUtils
    fun is_even(int n) int
        val remainder := n % 2
        if remainder == 0
            return 1
        else
            return 0
        end
    end

    fun power(int base, int exp) int
        val result := 1
        for i in exp
            result *= base
        end
        return result
    end

    fun fibonacci(int terms) int
        val a := 0
        val b := 1
        val next := 0
        
        for i in terms
            scho(46)
            next := a + b
            a := b
            b := next
        end
        
        return a
    end
end

namespace TermIO
    fun print_newline()
        scho(10)
    end

    fun print_space()
        scho(32)
    end

    fun print_ok()
        scho(79)
        scho(75)
        scho(33)
        scho(10)
    end

    fun print_error()
        scho(69)
        scho(82)
        scho(82)
        scho(79)
        scho(82)
        scho(10)
    end
end

namespace CoreEngine
    fun run_diagnostics() int
        val status := 1
        val test_val := 14
        
        val check := MathUtils.is_even(test_val)
        if check == 1
            TermIO.print_ok()
        else
            TermIO.print_error()
            status := 0
        end
        
        val p_res := MathUtils.power(2, 5)
        
        val fib_result := MathUtils.fibonacci(8)
        TermIO.print_newline()
        
        return status
    end
end

val execution_flag := 1
if execution_flag == 1
    val exit_code := CoreEngine.run_diagnostics()
else
    scho('a')
end
