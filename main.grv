import "math"

int fact_res = math.factorial(5)
if fact_res != 120
    return 1
end

int fact_zero = math.factorial(0)
if fact_zero != 1
    return 1
end

int sum_res = math.sumative(10)
if sum_res != 55
    return 1
end

int pow_pos = math.power(2, 3)
if pow_pos != 8
    return 1
end

int pow_zero = math.power(5, 0)
if pow_zero != 1
    return 1
end

scho('A')

return 0
